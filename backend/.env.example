# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easymomo?schema=public"

# Authentication
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Paystack (NEVER expose PAYSTACK_SECRET_KEY to Android or client apps)
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="https://easymomo.app/payment/callback"

# Admin Panel Credentials (auto-provisioned as ADMIN on login)
ADMIN_EMAIL="admin@easymomo.app"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="EasyMoMo Admin"
ADMIN_PHONE="0240000000"

# CORS & Rate Limiting
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
