generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EntitlementStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NetworkType {
  MTN
  AT
  TELECEL
}

enum TransactionType {
  CASH_IN
  CASH_OUT
  AIRTIME
  DATA
  MERCHANT_PAY
  BALANCE
  COMMISSION
  CUSTOM_USSD
}

enum ProcessingType {
  AUTOMATED_USSD
  CUSTOMER_LED
  MANUAL_USSD
}

enum TransactionStatus {
  DRAFT
  PROCESSING
  AWAITING_CUSTOMER
  AWAITING_VERIFICATION
  SUCCESSFUL
  FAILED
  CANCELLED
  UNKNOWN
}

model User {
  id            String        @id @default(uuid())
  fullName      String        @map("full_name")
  email         String        @unique
  phone         String        @unique
  passwordHash  String        @map("password_hash")
  role          UserRole      @default(AGENT)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  trialConsumed Boolean       @default(false) @map("trial_consumed")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  entitlement     SubscriptionEntitlement?
  payments        Payment[]
  transactions    Transaction[]
  customerNumbers CustomerNumber[]
  devices         UserDevice[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model UserDevice {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceId     String   @map("device_id")
  deviceName   String?  @map("device_name")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model TrialDevice {
  id          String   @id @default(uuid())
  deviceId    String   @unique @map("device_id")
  firstUserId String   @map("first_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("trial_devices")
}

model SubscriptionPlan {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("GHS")
  billingInterval BillingInterval @map("billing_interval")
  durationDays    Int             @map("duration_days")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  entitlements SubscriptionEntitlement[]
  payments     Payment[]

  @@map("subscription_plans")
}

model SubscriptionEntitlement {
  id                  String            @id @default(uuid())
  userId              String            @unique @map("user_id")
  status              EntitlementStatus @default(TRIAL)
  trialStartedAt      DateTime?         @map("trial_started_at")
  trialExpiresAt      DateTime?         @map("trial_expires_at")
  paidUntil           DateTime?         @map("paid_until")
  currentPlanId       String?           @map("current_plan_id")
  recurringAuthorized Boolean           @default(false) @map("recurring_authorized")
  authorizationCode   String?           @map("authorization_code")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPlan SubscriptionPlan? @relation(fields: [currentPlanId], references: [id])

  @@index([status])
  @@map("subscription_entitlements")
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  planId                String        @map("plan_id")
  provider              String        @default("PAYSTACK")
  reference             String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("GHS")
  channel               String?
  status                PaymentStatus @default(PENDING)
  authorizationReusable Boolean       @default(false) @map("authorization_reusable")
  paidAt                DateTime?     @map("paid_at")
  rawMetadata           Json?         @map("raw_metadata")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
  @@index([reference])
  @@map("payments")
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  clientTransactionId String            @map("client_transaction_id")
  providerReference   String?           @map("provider_reference")
  network             NetworkType
  transactionType     TransactionType   @map("transaction_type")
  processingType      ProcessingType    @map("processing_type")
  recipientNumber     String            @map("recipient_number")
  amount              Decimal           @db.Decimal(12, 2)
  bundleId            String?           @map("bundle_id")
  bundleName          String?           @map("bundle_name")
  status              TransactionStatus
  confirmationSource  String?           @map("confirmation_source")
  providerResponse    String?           @map("provider_response")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle DataBundle?        @relation(fields: [bundleId], references: [id])
  events TransactionEvent[]

  @@unique([userId, clientTransactionId])
  @@index([userId, createdAt])
  @@index([userId, network, transactionType, status])
  @@map("transactions")
}

model TransactionEvent {
  id             String             @id @default(uuid())
  transactionId  String             @map("transaction_id")
  eventType      String             @map("event_type")
  previousStatus TransactionStatus? @map("previous_status")
  newStatus      TransactionStatus  @map("new_status")
  details        String?
  createdAt      DateTime           @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("transaction_events")
}

model UssdFlowProfile {
  id              String      @id @default(uuid())
  network         NetworkType
  transactionType String      @map("transaction_type")
  version         Int
  configuration   Json
  enabled         Boolean     @default(false)
  lastVerifiedAt  DateTime?   @map("last_verified_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([network, transactionType, version])
  @@index([network, transactionType, enabled])
  @@map("ussd_flow_profiles")
}

model NetworkProfile {
  id            String      @id @default(uuid())
  network       NetworkType @unique
  configuration Json
  version       Int         @default(1)
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("network_profiles")
}

model DataBundle {
  id             String      @id @default(uuid())
  network        NetworkType
  name           String
  allowance      String
  price          Decimal     @db.Decimal(12, 2)
  validity       String
  providerOption String      @map("provider_option")
  active         Boolean     @default(true)
  lastVerifiedAt DateTime?   @map("last_verified_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  transactions Transaction[]

  @@index([network, active])
  @@map("data_bundles")
}

model SystemSetting {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false) @map("is_secret")
  description String   @default("")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model CustomerNumber {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  phoneHash                String    @map("phone_hash")
  encryptedNormalizedPhone String    @map("encrypted_normalized_phone")
  encryptedDisplayPhone    String    @map("encrypted_display_phone")
  encryptedNickname        String?   @map("encrypted_nickname")
  firstUsedAt              DateTime  @map("first_used_at")
  lastUsedAt               DateTime  @map("last_used_at")
  usageCount               Int       @default(1) @map("usage_count")
  version                  Int       @default(1)
  deletedAt                DateTime? @map("deleted_at")
  syncedAt                 DateTime  @default(now()) @map("synced_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneHash])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("customer_numbers")
}
